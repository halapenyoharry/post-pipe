<?xml version="1.0" encoding="UTF-8"?>
<opml version="2.0">
  <head>
    <title>Example site</title>
  </head>
  <body>
    <outline text="ScienceDaily" title="ScienceDaily" type="rss" xmlUrl="https://www.sciencedaily.com/rss/all.xml"/>
    <outline text="ProPublica" title="ProPublica" type="rss" xmlUrl="https://www.propublica.org/feeds/propublica/main"/>
    <!-- One outline per source. type says what xmlUrl is: rss, atom or json
         (a feed; left off, a feed is inferred), local (a folder of pieces),
         page (one article's address, read at build as one item), or pages
         (a local text file of such addresses, one per line). The example
         reads two public feeds, so anyone who builds it sees a graph
         without bringing data of their own; the build fetches them, and
         nothing else, over the network. -->
  </body>
</opml>
