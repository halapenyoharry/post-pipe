#!/usr/bin/env node
// Runs the pipeline by invoking the real stage programs one after another. There is no second
// implementation here: `rtz build` is exactly what you would type by hand, written down once.
import fs from 'node:fs';
import os from 'node:os';
import path from 'node:path';
import { spawnSync } from 'node:child_process';
import { fileURLToPath } from 'node:url';
import { cli, die, log } from '../lib/io.js';
import { makeConfig } from '../lib/config.js';
import { untaggedReport } from '../lib/untagged.js';

const usage = `rtz-build — run the whole pipeline from one config file

usage: rtz-build --config rtz.config.json [-o OUTDIR] [--no-view] [--no-emerge] [--discover]

rtz.config.json (paths are relative to the config file; ~ is expanded):
  {
    "out": "out",
    "sources": [
      { "adapter": "jsonfeed",    "path": "wire.feed.json" },
      { "adapter": "frontmatter", "path": "~/Posts", "source": "My Writing", "field": "tags" },
      { "adapter": "pairs",       "path": "archive.tsv", "source": "Archive" },
      { "adapter": "markdown",    "path": "~/vault", "source": "Notes", "inline": true }
    ],
    "overrides": "overrides.json",     optional, human decisions
    "ledger": "stone.ledger.json",     concept-id ledger, kept across builds; default OUTDIR/ledger.json, false for none
    "seeds": [],                       optional extra seed files
    "noSeed": false,
    "discover": false,                 propose new tags for untagged items from recurring phrases:
                                       true attaches them; "queue" writes them to the queue file and
                                       attaches none (only the overrides' "accept" list is attached)
    "queue": "rtagz-queue.json",       the queue file for discover "queue"; default beside the overrides
                                       file (or in OUTDIR with none); provisional
    "emerge": true,                    earn tags from item text (concepts rtz-stone already made)
    "engine": { "mergeThreshold": 0.7 },  optional overrides of lib/config.js defaults
    "skos": { "base": "urn:rosetta-tagz:", "lang": "en" }   the SKOS files' base IRI and label language
                                       (both provisional; defaults shown); false writes no SKOS files
  }

Writes to OUTDIR: records.jsonl, [records.discovered.jsonl, discover.report.json], stone.json, records.all.jsonl, universe.json,
skos.jsonld and skos.ttl (rtz-skos; a failure there is one line, never a failed build), view.html, build.json (stages; discover, the mode that ran;
the ledger summary: path, minted, reused, retired, splits, merges, this build's events; queue: its path and count, with discover "queue";
and untagged: every item with no tag shown at the build's bar, and why), the ledger at its path, and the queue at its path`;

const { values } = cli('rtz-build', usage, {
  config: { type: 'string' },
  o: { type: 'string', short: 'o' },
  'no-view': { type: 'boolean' },
  'no-emerge': { type: 'boolean' },
  discover: { type: 'boolean' },
});
if (!values.config) die(usage, 2);

const bin = path.dirname(fileURLToPath(import.meta.url));
const configPath = path.resolve(values.config);
const base = path.dirname(configPath);
const config = JSON.parse(fs.readFileSync(configPath, 'utf8'));
const resolve = (p) => (p.startsWith('~') ? path.join(os.homedir(), p.slice(1)) : path.resolve(base, p));
const out = path.resolve(values.o ? values.o : config.out ? resolve(config.out) : 'out');
fs.mkdirSync(out, { recursive: true });

const manifest = { built: new Date().toISOString(), config: configPath, stages: [] };
function stage(name, program, args, { capture = false } = {}) {
  const t0 = Date.now();
  const r = spawnSync(process.execPath, [path.join(bin, program), ...args], { encoding: 'utf8', maxBuffer: 1 << 30 });
  if (r.stderr) process.stderr.write(r.stderr.split('\n').filter(Boolean).map((l) => `  ${l}\n`).join(''));
  if (r.status !== 0) die(`rtz-build: stage "${name}" failed (exit ${r.status})`);
  manifest.stages.push({ name, program, ms: Date.now() - t0 });
  return capture ? r.stdout : null;
}

log(`rtz-build: ${configPath} -> ${out}`);
const records = [];
for (const s of config.sources ?? []) {
  const args = [s.adapter, resolve(s.path)];
  if (s.source) args.push('--source', s.source);
  if (s.field) args.push('--field', s.field);
  if (s.inline) args.push('--inline');
  log(`ingest ${s.adapter} ${s.path}`);
  records.push(stage(`ingest ${s.adapter}`, 'rtz-ingest', args, { capture: true }));
}
if (!records.length) die('rtz-build: config has no sources');
fs.writeFileSync(path.join(out, 'records.jsonl'), records.join(''));

let engineFile = [];
if (config.engine) {
  fs.writeFileSync(path.join(out, 'engine.json'), JSON.stringify(config.engine, null, 1));
  engineFile = ['--config', path.join(out, 'engine.json')];
}
let baseRecords = path.join(out, 'records.jsonl');
// discover: true | "queue" | false (the --discover flag is true); anything else truthy is true
const discoverMode = values.discover ? true : config.discover === 'queue' ? 'queue' : Boolean(config.discover);
const discovering = Boolean(discoverMode);
const overridesPath = config.overrides && fs.existsSync(resolve(config.overrides)) ? resolve(config.overrides) : null;
const reportPath = path.join(out, 'discover.report.json');
let queuePath = null;
if (discovering) {
  log(discoverMode === 'queue' ? 'discover (queue)' : 'discover');
  baseRecords = path.join(out, 'records.discovered.jsonl');
  const args = [path.join(out, 'records.jsonl'), '--all', '-o', baseRecords, '--report', reportPath, ...engineFile];
  if (overridesPath) args.push('--overrides', overridesPath);
  if (discoverMode === 'queue') {
    // the queue lives beside the overrides file, the file a human moves its candidates into
    queuePath = config.queue ? resolve(config.queue) : config.overrides ? path.join(path.dirname(resolve(config.overrides)), 'rtagz-queue.json') : path.join(out, 'rtagz-queue.json');
    fs.mkdirSync(path.dirname(queuePath), { recursive: true });
    args.push('--queue', queuePath);
  }
  stage('discover', 'rtz-discover', args);
}
manifest.discover = discoverMode;
const stoneArgs = [baseRecords, '-o', path.join(out, 'stone.json'), ...engineFile];
if (overridesPath) stoneArgs.push('--overrides', overridesPath);
const ledgerPath = config.ledger === false ? null : config.ledger ? resolve(config.ledger) : path.join(out, 'ledger.json');
if (ledgerPath) stoneArgs.push('--ledger', ledgerPath);
if (config.noSeed) stoneArgs.push('--no-seed');
for (const f of config.seeds ?? []) stoneArgs.push('--seed', resolve(f));
log('stone');
stage('stone', 'rtz-stone', stoneArgs);

let finalRecords = baseRecords;
if (config.emerge !== false && !values['no-emerge']) {
  log('emerge');
  stage('emerge', 'rtz-emerge', [path.join(out, 'stone.json'), baseRecords, '--all', '-o', path.join(out, 'records.all.jsonl'), ...engineFile]);
  finalRecords = path.join(out, 'records.all.jsonl');
}
log('universe');
stage('universe', 'rtz-universe', [path.join(out, 'stone.json'), finalRecords, '-o', path.join(out, 'universe.json')]);
// The SKOS serialization never fails a build: a failure is one line, and neither file is written.
if (config.skos !== false) {
  const skos = config.skos && typeof config.skos === 'object' ? config.skos : {};
  const args = [path.join(out, 'universe.json'), '-o', out];
  if (typeof skos.base === 'string') args.push('--base', skos.base);
  if (skos.lang === null || skos.lang === false || skos.lang === '') args.push('--no-lang');
  else if (typeof skos.lang === 'string') args.push('--lang', skos.lang);
  log('skos');
  const t0 = Date.now();
  const r = spawnSync(process.execPath, [path.join(bin, 'rtz-skos'), ...args], { encoding: 'utf8', maxBuffer: 1 << 30 });
  if (r.status === 0) {
    if (r.stderr) process.stderr.write(r.stderr.split('\n').filter(Boolean).map((l) => `  ${l}\n`).join(''));
    manifest.stages.push({ name: 'skos', program: 'rtz-skos', ms: Date.now() - t0 });
  } else {
    const last = (r.stderr || '').trim().split('\n').pop() || `exit ${r.status}`;
    log(`rtz-build: skos files not written (${last})`);
  }
}
if (!values['no-view']) {
  log('view');
  stage('view', 'rtz-view', [path.join(out, 'universe.json'), '-o', path.join(out, 'view.html')]);
}
const stone = JSON.parse(fs.readFileSync(path.join(out, 'stone.json'), 'utf8'));
if (stone.ledger) manifest.ledger = stone.ledger;
// The queue's summary is a reading of the file rtz-discover wrote; it never fails the build.
if (queuePath) {
  try {
    const q = JSON.parse(fs.readFileSync(queuePath, 'utf8'));
    manifest.queue = { path: queuePath, candidates: (q.candidates ?? []).length };
    log(`queue: ${manifest.queue.candidates} candidates in ${queuePath}, none attached; move one into the overrides' "accept" list to make it a tag`);
  } catch (e) {
    log(`rtz-build: queue not summarized (${e.message})`);
  }
}
// The untagged report is a reading of files already written; it never fails the build.
try {
  const universe = JSON.parse(fs.readFileSync(path.join(out, 'universe.json'), 'utf8'));
  const report = discovering ? JSON.parse(fs.readFileSync(reportPath, 'utf8')) : null;
  const bar = discovering ? makeConfig(config.engine).discover.sourceCoherenceRatio : null;
  manifest.untagged = untaggedReport(universe, report, bar);
  log(`untagged: ${manifest.untagged.count} items with no tag at the ${bar ?? 'build'}${bar ? '× bar' : ''}, ${manifest.untagged.none} with none at any`);
} catch (e) {
  log(`rtz-build: untagged report not written (${e.message})`);
}
fs.writeFileSync(path.join(out, 'build.json'), JSON.stringify(manifest, null, 1) + '\n');
log(`done: ${stone.stats.tags} tags -> ${stone.stats.concepts} concepts; review queue: ${stone.relations.filter((r) => r.type === 'near' || r.type === 'closeMatch').length}; open ${path.join(out, 'view.html')}`);
